# Not VITE_ prefixed on purpose. These stay in Node and never
# get bundled into anything the browser can read.
PROPSPACE_CLIENT_ID=
PROPSPACE_CLIENT_SECRET=

# PF Expert → Developer Resources → API Credentials. The secret is shown once,
# when the key is created, and cannot be read back afterwards.
PROPERTYFINDER_API_KEY=
PROPERTYFINDER_API_SECRET=

# Owner search (Apify) — optional.
APIFY_TOKEN=
APIFY_ACTOR_ID=

# Bayut / dubizzle profolio lead stats. One key serves both portals.
BAYUT_API_KEY=

# Reelly off-plan project catalogue. Header auth: X-API-Key.
REELLY_API_KEY=
